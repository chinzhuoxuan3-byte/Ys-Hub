local function clearBanFlags()
    task.spawn(function()
        while antiBanActive do
            local char = LocalPlayer.Character
            if char then
                for _, obj in ipairs(char:GetDescendants()) do
                    if obj:IsA("BoolValue") or obj:IsA("NumberValue") or obj:IsA("StringValue") then
                        local nameLower = string.lower(obj.Name)
                        if string.find(nameLower, "ban") or string.find(nameLower, "flag") or string.find(nameLower, "kick") then
                            pcall(function()
                                if obj:IsA("BoolValue") then obj.Value = false end
                                if obj:IsA("NumberValue") then obj.Value = 0 end
                                if obj:IsA("StringValue") then obj.Value = "" end
                            end)
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end)
end

local function enableAntiBan()
    if antiBanActive then return end
    antiBanActive = true
    hookBannedWho()
    hookBanRemote()
    hookClientEffect()
    hookZoneChecking()
    hookBannedPlayers()
    hookBanAsync()
    hookKick()
    hookNamecall()
    hookHumanoidSpeed()
    hookProximityPrompt()
    clearBanFlags()
    print("[AntiBan] Activated")
end

