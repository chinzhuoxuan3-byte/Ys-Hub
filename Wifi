local function safeHookFunction(func, hook)
    if not func then return end
    for i, v in ipairs(hookedFunctions) do
        if v.original == func then return v.hook end
    end
    local success, h = pcall(function()
        return hookfunction(func, hook)
    end)
    if success then
        table.insert(hookedFunctions, {original = func, hook = h})
        return h
    end
    return nil
end

local function safeHookRemote(remote)
    if hookedRemotes[remote] then return end
    if remote and remote.FireServer then
        local old = remote.FireServer
        local success = pcall(function()
            remote.FireServer = function(self, ...)
                local args = {...}
                for i, v in ipairs(args) do
                    if type(v) == "string" then
                        local lower = string.lower(v)
                        if string.find(lower, "ban") or string.find(lower, "封禁") or string.find(lower, "kick") or string.find(lower, "cheat") or string.find(lower, "作弊") or string.find(lower, "穿墙") or string.find(lower, "加速") or string.find(lower, "飞行") or string.find(lower, "freefall") or string.find(lower, "falling") then
                            args[i] = ""
                        end
                    end
                    if type(v) == "number" and v < 0 then args[i] = 1 end
                    if type(v) == "table" then
                        if v.Type == "AFK" or v.Type == "In" then return end
                        if v.Player == LocalPlayer then return end
                    end
                end
                return old(self, unpack(args))
            end
        end)
        if success then hookedRemotes[remote] = true end
    end
    if remote and remote.InvokeServer then
        pcall(function()
            remote.InvokeServer = function(self, ...) return nil end
        end)
    end
end

local function hookAllRemotesInFolder(folder)
    if not folder then return end
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            safeHookRemote(child)
        elseif child:IsA("Folder") or child:IsA("Model") then
            hookAllRemotesInFolder(child)
        end
    end
end

local function deepHookRemotes()
    pcall(function() hookAllRemotesInFolder(ReplicatedStorage) end)
end

