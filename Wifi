local function hookNamecall()
    pcall(function()
        local mt = getrawmetatable(game)
        if not mt then return end
        setreadonly(mt, false)
        local oldNamecall = mt.__namecall
        mt.__namecall = function(self, ...)
            local method = getnamecallmethod()
            if method == "Kick" or method == "BanAsync" then
                if self == LocalPlayer or self == Players then return nil end
            end
            if method == "FireServer" or method == "InvokeServer" then
                if self and self.Name then
                    local nameLower = string.lower(self.Name)
                    if string.find(nameLower, "ban") or string.find(nameLower, "kick") or string.find(nameLower, "banned") or string.find(nameLower, "cheat") then
                        return nil
                    end
                end
                local args = {...}
                for i, v in ipairs(args) do
                    if type(v) == "string" then
                        local lower = string.lower(v)
                        if string.find(lower, "ban") or string.find(lower, "封禁") or string.find(lower, "kick") or string.find(lower, "cheat") or string.find(lower, "作弊") or string.find(lower, "穿墙") or string.find(lower, "加速") or string.find(lower, "飞行") then
                            args[i] = ""
                        end
                    end
                    if type(v) == "number" and v < 0 then args[i] = 1 end
                    if type(v) == "table" and v.Type == "AFK" then return nil end
                    if type(v) == "table" and v.Player == LocalPlayer then return nil end
                end
                return oldNamecall(self, unpack(args))
            end
            return oldNamecall(self, ...)
        end
        setreadonly(mt, true)
    end)
end

