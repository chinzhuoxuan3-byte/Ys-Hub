local function hookRaycast()
    pcall(function()
        local oldRaycast = Workspace.Raycast
        Workspace.Raycast = function(origin, direction, params)
            if params and params.FilterDescendantsInstances then
                local newFilter = {}
                for _, inst in ipairs(params.FilterDescendantsInstances) do
                    if inst ~= LocalPlayer.Character then
                        table.insert(newFilter, inst)
                    end
                end
                params.FilterDescendantsInstances = newFilter
            end
            return oldRaycast(origin, direction, params)
        end
    end)
end

local function clearBanFlags()
    task.spawn(function()
        while antiBanActive do
            local char = LocalPlayer.Character
            if char then
                for _, obj in ipairs(char:GetDescendants()) do
                    if obj:IsA("BoolValue") or obj:IsA("NumberValue") or obj:IsA("StringValue") or obj:IsA("IntValue") then
                        local nameLower = string.lower(obj.Name)
                        if string.find(nameLower, "ban") or string.find(nameLower, "flag") or string.find(nameLower, "kick") or string.find(nameLower, "banned") or string.find(nameLower, "detect") then
                            pcall(function()
                                if obj:IsA("BoolValue") then obj.Value = false end
                                if obj:IsA("NumberValue") or obj:IsA("IntValue") then obj.Value = 0 end
                                if obj:IsA("StringValue") then obj.Value = "" end
                            end)
                        end
                    end
                end
                local playerInfo = char:FindFirstChild("PlayerInfo")
                if playerInfo then
                    for _, obj in ipairs(playerInfo:GetChildren()) do
                        local nameLower = string.lower(obj.Name)
                        if string.find(nameLower, "ban") or string.find(nameLower, "flag") or string.find(nameLower, "kick") or string.find(nameLower, "banned") then
                            pcall(function()
                                if obj:IsA("BoolValue") then obj.Value = false end
                                if obj:IsA("NumberValue") or obj:IsA("IntValue") then obj.Value = 0 end
                                if obj:IsA("StringValue") then obj.Value = "" end
                            end)
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

local function hookAllRemotes()
    local events = {}
    for _, obj in getnilinstances() do
        if obj:IsA("RemoteEvent") then
            table.insert(events, obj)
        end
    end
    local function searchFolder(folder)
        if not folder then return end
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("RemoteEvent") then
                table.insert(events, child)
            end
            if child:IsA("Folder") or child:IsA("Model") then
                searchFolder(child)
            end
        end
    end
    searchFolder(ReplicatedStorage)
    searchFolder(Workspace)
    for _, event in ipairs(events) do
        pcall(function()
            local oldFire = event.FireServer
            event.FireServer = function(self, ...)
                local args = {...}
                for i, v in ipairs(args) do
                    if type(v) == "string" then
                        if string.find(string.lower(v), "ban") or string.find(string.lower(v), "kick") or string.find(string.lower(v), "封禁") or string.find(string.lower(v), "作弊") then
                            args[i] = ""
                        end
                    end
                    if type(v) == "number" and v < 0 then
                        args[i] = 0
                    end
                    if type(v) == "boolean" and v == true then
                        if string.find(string.lower(event.Name), "ban") or string.find(string.lower(event.Name), "kick") or string.find(string.lower(event.Name), "banned") then
                            args[i] = false
                        end
                    end
                end
                return oldFire(self, unpack(args))
            end
        end)
    end
end

