local function getWeapon()
    local char = LocalPlayer.Character
    if not char then return nil end
    local tool = char:FindFirstChild("\230\139\179\229\164\180")
    if not tool then
        tool = char:FindFirstChild("\231\148\181\229\135\187\230\158\170")
        if not tool then
            tool = char:FindFirstChildOfClass("Tool")
        end
    end
    return tool
end

local function getAttackRemote()
    local weapon = getWeapon()
    if not weapon then return nil end
    return weapon:FindFirstChild("Attack") or weapon:FindFirstChild("AttackRemote")
end

local function getClosestTarget()
    local char = LocalPlayer.Character
    if not char then return nil end
    if not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then return nil end
    
    local originPart = char:FindFirstChild("HumanoidRootPart")
    if not originPart then return nil end
    local originPos = originPart.Position

    local best = nil
    local bestDist = Settings.Range

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if Settings.TeamCheck and plr.Team == LocalPlayer.Team then continue end

        local targetChar = plr.Character
        if not targetChar then continue end
        
        local hum = targetChar:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        local targetPart = targetChar:FindFirstChild("HumanoidRootPart")
        if not targetPart then continue end

        if Settings.WallCheck then
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Blacklist
            params.FilterDescendantsInstances = {char, targetChar}
            local result = Workspace:Raycast(originPos, (targetPart.Position - originPos), params)
            if result then continue end
        end

        local dist = (targetPart.Position - originPos).Magnitude
        if dist < bestDist then
            bestDist = dist
            best = {
                Character = targetChar,
                Part = targetPart,
                Position = targetPart.Position,
                Player = plr
            }
        end
    end
    return best
end

local function createTracer(origin, hitPos)
    if not Settings.Tracer then return end
    local part = Instance.new("Part")
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 1
    part.Size = Vector3.new(0.1, 0.1, 0.1)
    part.Position = origin
    part.Parent = Workspace

    local att0 = Instance.new("Attachment", part)
    local att1 = Instance.new("Attachment", part)
    att1.WorldPosition = hitPos

    local beam = Instance.new("Beam", part)
    beam.Attachment0 = att0
    beam.Attachment1 = att1
    beam.Texture = "rbxassetid://446111271"
    beam.Width0 = 0.3
    beam.Width1 = 0.3
    beam.LightEmission = 1
    beam.FaceCamera = true
    beam.Color = ColorSequence.new(Color3.fromRGB(255, 50, 50))
    beam.Transparency = NumberSequence.new(0.2)

    task.delay(0.3, function() part:Destroy() end)
end

local function playHitSound()
    if not Settings.HitSound then return end
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://5633695679"
    sound.Volume = 1
    sound.Parent = Workspace
    sound:Play()
    task.delay(1, function() sound:Destroy() end)
end

local function fireRagebot(target)
    if not target then return end
    local remote = getAttackRemote()
    if not remote then return end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then return end

    local originPart = char:FindFirstChild("HumanoidRootPart")
    if not originPart then return end

    local origin = originPart.Position
    local hitPos = target.Position
    local direction = (hitPos - origin).Unit
    local cframe = CFrame.new(hitPos, hitPos + direction)

    createTracer(origin, hitPos)
    playHitSound()
    remote:FireServer(target.Player, cframe)
end

local function fireKillaura(target)
    if not target then return end
    local remote = getAttackRemote()
    if not remote then return end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then return end

    local originPart = char:FindFirstChild("HumanoidRootPart")
    if not originPart then return end

    local origin = originPart.Position
    local hitPos = target.Position
    local direction = (hitPos - origin).Unit
    local cframe = CFrame.new(hitPos, hitPos + direction)

    createTracer(origin, hitPos)
    playHitSound()
    remote:FireServer(target.Player, cframe)
end

local function startRagebot()
    if ragebotLoop then return end
    ragebotLoop = task.spawn(function()
        while Settings.RagebotEnabled do
            local target = getClosestTarget()
            if target then
                pcall(fireRagebot, target)
            end
            task.wait(Settings.Interval)
        end
        ragebotLoop = nil
    end)
end

local function startKillaura()
    if killauraLoop then return end
    killauraLoop = task.spawn(function()
        while Settings.KillauraEnabled do
            local target = getClosestTarget()
            if target then
                pcall(fireKillaura, target)
            else
                task.wait(0.1)
            end
            task.wait(Settings.Interval)
        end
        killauraLoop = nil
    end)
end

