local function hookNamecall()
    local mt = getrawmetatable(game)
    if not mt then return end
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = function(self, ...)
        local method = getnamecallmethod()
        if method == "Kick" or method == "BanAsync" then
            if self == LocalPlayer or self == Players then
                return nil
            end
        end
        if method == "FireServer" or method == "InvokeServer" then
            if self and self.Name then
                local nameLower = string.lower(self.Name)
                if string.find(nameLower, "ban") or string.find(nameLower, "kick") or string.find(nameLower, "banned") then
                    return nil
                end
            end
        end
        return oldNamecall(self, ...)
    end
    setreadonly(mt, true)
end

