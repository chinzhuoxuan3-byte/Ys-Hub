local function getTargetPart(target)
    local parts = {"HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso"}
    for _, name in ipairs(parts) do
        local part = target.Character:FindFirstChild(name)
        if part then return part end
    end
    return nil
end

local function getHitPosition(target)
    local part = getTargetPart(target)
    if not part then return nil end
    if math.random(1, 100) <= Settings.HeadshotChance then
        local head = target.Character:FindFirstChild("Head")
        if head then return head.Position end
    end
    return part.Position
end

local function fireWeapon(target)
    if not target or not WeaponUsing then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    
    local hitPos = getHitPosition(target)
    if not hitPos then return end
    
    local targetHum = target.Character:FindFirstChildOfClass("Humanoid")
    if not targetHum then return end
    
    createTracer(char.HumanoidRootPart.Position, hitPos)
    playHitSound()
    
    local args = {
        targetHum,
        "攻击",
        {
            ["命中位置"] = hitPos
        }
    }
    pcall(function()
        WeaponUsing:FireServer(unpack(args))
    end)
end

local function teleportToTarget(target)
    if not target or not target.Character then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end
    
    local targetCFrame = targetRoot.CFrame
    local behindPos = targetCFrame.Position - targetCFrame.LookVector * Settings.TeleportDistance
    behindPos = behindPos + Vector3.new(0, Settings.TeleportYOffset, 0)
    
    root.CFrame = CFrame.new(behindPos, targetCFrame.Position)
end

local function triggerReload()
    local weapon = getWeapon()
    if not weapon then return end
    
    local attack = weapon:FindFirstChild("Attack")
    if attack then
        pcall(function()
            attack:FireServer(nil, "Reload")
        end)
    end
end

local function autoReload()
    if not Settings.AutoReload then return end
    if reloading then return end
    
    local weapon = getWeapon()
    if not weapon then return end
    
    local ammo = getWeaponAmmo(weapon)
    local maxAmmo = getWeaponMaxAmmo(weapon)
    
    if ammo and maxAmmo then
        if ammo.Value <= 0 and ammo.Value < maxAmmo.Value then
            reloading = true
            triggerReload()
            local reloadTime = getWeaponReloadTime(weapon)
            task.wait(reloadTime)
            reloading = false
        end
    end
end

local function autoEquipBestWeapon()
    if not Settings.AutoEquip then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local weapons = {}
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            table.insert(weapons, child)
        end
    end
    local backpack = LocalPlayer.Backpack
    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") then
                table.insert(weapons, child)
            end
        end
    end
    if #weapons == 0 then return end
    local current = getWeapon()
    local best = weapons[1]
    for _, w in ipairs(weapons) do
        if w.Name and best.Name and #w.Name > #best.Name then
            best = w
        end
    end
    if current ~= best then
        hum:EquipTool(best)
    end
end

local function resetTarget()
    currentKillauraTarget = nil
    if killauraLoop then
        task.cancel(killauraLoop)
        killauraLoop = nil
    end
    if Settings.KillauraEnabled then
        startKillaura()
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    resetTarget()
end)

local function startRagebot()
    if ragebotLoop then return end
    ragebotLoop = task.spawn(function()
        while Settings.RagebotEnabled do
            local target = getClosestTarget()
            if target then
                pcall(fireWeapon, target)
                if Settings.TeleportEnabled then
                    pcall(teleportToTarget, target)
                end
            end
            if Settings.AutoReload then pcall(autoReload) end
            if Settings.AutoEquip then pcall(autoEquipBestWeapon) end
            task.wait(Settings.Interval)
        end
        ragebotLoop = nil
    end)
end

local function startKillaura()
    if killauraLoop then return end
    killauraLoop = task.spawn(function()
        while Settings.KillauraEnabled do
            if not isValidTarget(currentKillauraTarget) then
                currentKillauraTarget = getClosestTarget()
            end
            
            if isValidTarget(currentKillauraTarget) then
                if Settings.TeleportEnabled then
                    pcall(teleportToTarget, currentKillauraTarget)
                end
                pcall(fireWeapon, currentKillauraTarget)
            end
            
            if Settings.AutoReload then pcall(autoReload) end
            if Settings.AutoEquip then pcall(autoEquipBestWeapon) end
            task.wait(Settings.Interval)
        end
        killauraLoop = nil
        currentKillauraTarget = nil
    end)
end

local function startSilentAim()
    if silentAimLoop then return end
    silentAimLoop = task.spawn(function()
        while Settings.SilentAimEnabled do
            local target = getClosestTarget()
            if target and target.Part then
                local hitPos = getHitPosition(target)
                if hitPos then
                    local char = LocalPlayer.Character
                    if char then
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then
                            root.CFrame = CFrame.new(root.Position, hitPos)
                        end
                    end
                end
            end
            task.wait(0.01)
        end
        silentAimLoop = nil
    end)
end

