local ClientEffect = RemoteEvents and RemoteEvents:FindFirstChild("ClientEffect")
local ZoneChecking = RemoteEvents and RemoteEvents:FindFirstChild("ZoneChecking")

local function hookBannedWho()
    for _, v in getgc(true) do
        if type(v) == "function" then
            local info = debug.getinfo(v)
            if info and info.name == "BannedWho" then
                pcall(function()
                    hookfunction(v, function(self, player, duration, reason)
                        if player == LocalPlayer then
                            return nil
                        end
                        return v(self, player, duration, reason)
                    end)
                end)
                return true
            end
        end
    end
    return false
end

local function hookBanRemote()
    if Banned then
        pcall(function()
            local oldFire = Banned.FireServer
            Banned.FireServer = function(self, ...)
                local args = {...}
                if type(args[1]) == "number" and args[1] < 0 then
                    return nil
                end
                if type(args[2]) == "string" and args[2] then
                    return nil
                end
                return oldFire(self, unpack(args))
            end
        end)
        pcall(function()
            local oldInvoke = Banned.InvokeServer
            Banned.InvokeServer = function(self, ...)
                return nil
            end
        end)
    end
end

local function hookClientEffect()
    if ClientEffect then
        pcall(function()
            local oldFire = ClientEffect.FireServer
            ClientEffect.FireServer = function(self, ...)
                local args = {...}
                if type(args[1]) == "number" and args[1] < 0 then
                    return nil
                end
                if type(args[2]) == "string" then
                    local reason = args[2]
                    if string.find(reason, "封禁") or string.find(reason, "ban") or string.find(reason, "作弊") then
                        return nil
                    end
                end
                return oldFire(self, unpack(args))
            end
        end)
        pcall(function()
            local oldInvoke = ClientEffect.InvokeServer
            ClientEffect.InvokeServer = function(self, ...)
                return nil
            end
        end)
    end
end

local function hookZoneChecking()
    if ZoneChecking then
        pcall(function()
            local oldFire = ZoneChecking.FireServer
            ZoneChecking.FireServer = function(self, ...)
                local args = {...}
                if type(args[1]) == "table" and args[1] and args[1].Type == "AFK" then
                    return nil
                end
                if type(args[1]) == "table" and args[1] and args[1].Type == "In" then
                    return nil
                end
                return oldFire(self, unpack(args))
            end
        end)
    end
end

local function hookBannedPlayers()
    for _, v in getgc(true) do
        if type(v) == "table" and rawget(v, "BannedPlayers") then
            pcall(function()
                local oldIndex = v.__index
                v.__index = function(t, k)
                    if k == LocalPlayer then
                        return nil
                    end
                    return oldIndex(t, k)
                end
                local oldNewIndex = v.__newindex
                v.__newindex = function(t, k, val)
                    if k == LocalPlayer then
                        return nil
                    end
                    return oldNewIndex(t, k, val)
                end
            end)
            return true
        end
    end
    return false
end

local function hookBanAsync()
    pcall(function()
        local oldBan = Players.BanAsync
        Players.BanAsync = function(self, options)
            if options and options.UserIds then
                for _, id in ipairs(options.UserIds) do
                    if id == LocalPlayer.UserId then
                        return nil
                    end
                end
            end
            return oldBan(self, options)
        end
    end)
end

local function hookKick()
    pcall(function()
        local oldKick = LocalPlayer.Kick
        LocalPlayer.Kick = function(self, reason)
            if reason and (string.find(reason, "ban") or string.find(reason, "封禁") or string.find(reason, "作弊")) then
                return nil
            end
            return oldKick(self, reason)
        end
    end)
end

local function hookNamecall()
    local mt = getrawmetatable(game)
    if not mt then return end
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = function(self, ...)
        local method = getnamecallmethod()
        if method == "Kick" or method == "BanAsync" then
            if self == LocalPlayer or self == Players then
                return nil
            end
        end
        if method == "FireServer" or method == "InvokeServer" then
            if self and self.Name then
                local nameLower = string.lower(self.Name)
                if string.find(nameLower, "ban") or string.find(nameLower, "kick") then
                    return nil
                end
            end
        end
        return oldNamecall(self, ...)
    end
    setreadonly(mt, true)
end

